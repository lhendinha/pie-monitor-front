# URL da Function URL da Lambda `api` (sem barra no final)
VITE_API_URL=https://SUA_URL.lambda-url.sa-east-1.on.aws

# Canal de notificações em tempo real (API Gateway WebSocket).
# SEM ela o sino continua funcionando -- só perde o push, e atualiza quando
# a aba ganha foco. É por isso que o hook simplesmente não abre a conexão
# quando ela falta, em vez de quebrar.
VITE_WS_URL=wss://SUA_API.execute-api.sa-east-1.amazonaws.com/prod

# ─────────────────────────────────────────────────────────────────────────
# Credenciais do roteiro de verificação em PRODUÇÃO
# (`scripts/verificar-producao.mjs`). Vão no `.env.local`, não aqui.
#
# 🔴 NÃO são variáveis do Vite: não levam prefixo `VITE_` de propósito.
# Tudo que começa com `VITE_` é EMBUTIDO NO BUNDLE e vai parar no
# navegador de todo mundo -- uma senha ali seria pública. Estas são lidas
# pelo Node, direto do arquivo, e só existem na máquina de quem roda.
#
# O `.env.local` é gitignorado (ver `.gitignore`).
PJE_TEST_EMAIL=conta-de-teste@exemplo.com
PJE_TEST_SENHA=a-senha-dessa-conta
