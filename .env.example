# URL da Function URL da Lambda `api` (sem barra no final)
VITE_API_URL=https://SUA_URL.lambda-url.sa-east-1.on.aws

# Canal de notificações em tempo real (API Gateway WebSocket).
# SEM ela o sino continua funcionando -- só perde o push, e atualiza quando
# a aba ganha foco. É por isso que o hook simplesmente não abre a conexão
# quando ela falta, em vez de quebrar.
VITE_WS_URL=wss://SUA_API.execute-api.sa-east-1.amazonaws.com/prod
